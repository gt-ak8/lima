# Copy to .env and fill in. .env is gitignored.
# Consumed by ./justfile and forwarded to Lima via `limactl start --set ...`.

# Host directory mounted into the VM at the same absolute path.
HOST_PATH="/Users/you/dev/projects"

# Git identity inside the VM.
GIT_NAME="Your Name"
GIT_EMAIL="you@example.com"

# SSH commit signing key. `key::` prefix tells git the literal pubkey
# follows (no on-disk key lookup). Signing uses the forwarded SSH agent.
GIT_SIGNING_KEY="key::ssh-ed25519 AAAA... you@example.com"
